# ==============================================================================
# KONFIGURASI ENVIRONMENT PENGEMBANGAN
# Sistem Chatbot Layanan Digital & Gemini Tool Calling
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API & LLM CONFIGURATION
# ------------------------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_SIMILARITY_THRESHOLD=0.5

# Parameter Generasi Model Gemini (Sampling & Token Limits)
# Suhu rendah (0.0 - 0.2) direkomendasikan untuk function calling agar deterministik dan presisi
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_MAX_OUTPUT_TOKENS=2048

# Mode Function Calling untuk Gemini API: AUTO | ANY | NONE
GEMINI_FUNCTION_CALLING_MODE=AUTO


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

DATABASE_PATH=backend/database/database.db


# ------------------------------------------------------------------------------
# 3. GEMINI TOOLS & BUSINESS POLICY CONFIGURATION
# ------------------------------------------------------------------------------
# Batas default jumlah riwayat pesan yang diambil oleh Tool 3 (get_conversation_history)
CHAT_HISTORY_DEFAULT_LIMIT=20

# Pesan fallback standar jika query tidak ditemukan di knowledge base
DATABASE_FALLBACK_MSG=Mohon maaf kak, informasi tersebut tidak tersedia.
IGNORED_INSTRUCTION_FALLBACK_MSG=Mohon maaf kak, kami tidak dapat melakukan hal tersebut.
GENERAL_KNOWLEDGE_FALLBACK_MSG=Mohon maaf kak, informasi tersebut belum tersedia di sistem kami. Tim support kami akan membantu memberikan informasi lebih lanjut.


# ------------------------------------------------------------------------------
# 4. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Environment aplikasi (development | staging | production)
APP_ENV=development

# Mode debug backend
DEBUG=True

# Host & Port server backend FastAPI
HOST=0.0.0.0
PORT=8000

